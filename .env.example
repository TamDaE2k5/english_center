# ========================================================
# English Center Management System - Environment Variables
# ========================================================

# Database Configuration (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=english_center
DB_USER=postgres
DB_PASSWORD=postgres_secret_password

# Authentication (Shared JWT Secret)
# Phải đồng bộ giữa tất cả các services để verify token
JWT_SECRET=super_secret_jwt_key_english_center_2026_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Service Ports
PORT_GATEWAY=8080
PORT_ADMISSION=8081
PORT_STUDENT=8082
PORT_LEARNING=8083
PORT_FINANCE=8084
